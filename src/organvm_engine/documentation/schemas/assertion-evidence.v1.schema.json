{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-organvm.github.io/schema-definitions/assertion-evidence.v1.schema.json",
  "title": "Assertion Evidence v1",
  "description": "Evidence and freshness record for factual assertions, operator directives, current-state observations, and labeled inferences.",
  "type": "object",
  "required": [
    "contract_name", "contract_version", "assertion_id", "assertion_class", "statement",
    "verification_state", "evidence_references"
  ],
  "properties": {
    "contract_name": {"const": "assertion-evidence.v1"},
    "contract_version": {"const": 1},
    "assertion_id": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])[\\s\\S]+$(?![\\s\\S])"},
    "assertion_class": {
      "type": "string",
      "enum": ["external_fact", "operator_directive", "current_state", "inference", "historical_record", "ratified_axiom"]
    },
    "statement": {"type": "string", "minLength": 1},
    "fact": {
      "description": "Optional machine-readable predicate/value asserted by the human-readable statement. Consumers that make lifecycle or policy decisions must compare this value rather than infer facts from prose.",
      "type": "object",
      "required": ["predicate", "value"],
      "properties": {
        "predicate": {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "subject": {
          "description": "Optional stable or human-readable subject that disambiguates which entity the predicate describes.",
          "type": "string",
          "minLength": 1
        },
        "project_repository": {
          "description": "Optional canonical owner/name repository identity for facts whose subject alone is not globally unique, such as an industry name.",
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])(?!\\.{1,2}/)[A-Za-z0-9_.-]+/(?!\\.{1,2}$(?![\\s\\S]))[A-Za-z0-9_.-]+$(?![\\s\\S])"
        },
        "contributions": {
          "description": "Optional exact contribution vocabulary for an authorship fact.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "collaborators": {
          "description": "Optional exact collaborator vocabulary for an authorship fact.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "generated": {
          "description": "Optional exact generated-artifact vocabulary for an authorship fact.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "inherited": {
          "description": "Optional exact inherited-artifact vocabulary for an authorship fact.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "external": {
          "description": "Optional exact external-artifact vocabulary for an authorship fact.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "value": {"type": ["string", "number", "boolean", "null"]}
      },
      "additionalProperties": false
    },
    "verification_state": {"type": "string", "enum": ["unverified", "verified", "stale", "disputed"]},
    "inference_label": {"type": "string", "minLength": 1},
    "freshness": {
      "type": "object",
      "required": ["verified_at", "status"],
      "properties": {
        "verified_at": {"type": "string", "format": "date-time"},
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 315576000,
          "description": "Maximum freshness window in seconds, bounded to ten Julian years."
        },
        "status": {"type": "string", "enum": ["fresh", "stale", "not_applicable"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["fresh", "stale"]}}},
          "then": {"required": ["max_age_seconds"]}
        }
      ],
      "additionalProperties": false
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "independence_group", "evidence_type", "reference", "body_hash"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])[\\s\\S]+$(?![\\s\\S])"},
          "independence_group": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])[\\s\\S]+$(?![\\s\\S])"},
          "evidence_type": {
            "type": "string",
            "enum": [
              "immutable_source_event", "ratified_constitutional_record", "owner_record",
              "fresh_verifier_receipt", "primary_source", "secondary_source", "artifact", "other"
            ]
          },
          "reference": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])[\\s\\S]+$(?![\\s\\S])"},
          "body_hash": {"type": "string", "pattern": "^(?!.*[\\r\\n])sha256:[a-f0-9]{64}$(?![\\s\\S])"},
          "observed_at": {"type": "string", "format": "date-time"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"evidence_type": {"const": "fresh_verifier_receipt"}},
              "required": ["evidence_type"]
            },
            "then": {"required": ["observed_at"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"assertion_class": {"const": "inference"}}},
      "then": {"required": ["inference_label"]}
    },
    {
      "if": {"properties": {"assertion_class": {"const": "current_state"}}},
      "then": {"required": ["freshness"]}
    },
    {
      "if": {
        "properties": {
          "assertion_class": {"const": "operator_directive"},
          "verification_state": {"const": "verified"}
        }
      },
      "then": {"required": ["freshness"]}
    }
  ],
  "additionalProperties": false
}
